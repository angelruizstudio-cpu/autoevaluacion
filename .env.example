# ---------------------------------------------------------------------
# Copiar a .env.local para desarrollo. En Vercel van en
# Settings > Environment Variables.
#
# ADVERTENCIA: SUPABASE_SERVICE_ROLE_KEY NO lleva el prefijo
# NEXT_PUBLIC_. Si se lo pones, la llave se empaqueta en el bundle
# del navegador y cualquiera puede leer y borrar toda la base de
# datos. Es el error mas comun de este stack.
# ---------------------------------------------------------------------

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Secreto para firmar la cookie de sesion de la evaluacion.
# Generar con: openssl rand -base64 32
SESSION_SECRET=

# URL publica del sitio, para construir los enlaces de invitacion
NEXT_PUBLIC_SITE_URL=https://liderazgo.icpmi.org
